POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_DB=mlops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=mlops-platform
MLFLOW_ARTIFACT_ROOT=/mlartifacts

MODEL_NAME=income-classifier
AB_SPLIT_PERCENT=20
DRIFT_THRESHOLD=0.15
RETRAIN_METRIC_THRESHOLD=0.005

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://mlops:mlops@postgres/mlops
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here

API_DRIFT_URL=http://api:8000/admin/drift
API_RETRAIN_EVENT_URL=http://api:8000/admin/retrain-event

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MLFLOW_URL=http://localhost:5000
NEXT_PUBLIC_GRAFANA_URL=http://localhost:3001
