{
  "uid": "mlops-accuracy",
  "title": "Model Accuracy & Drift",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "enable": true,
        "expr": "increase(retrain_events_total[5m]) > 0",
        "iconColor": "rgba(255, 255, 0, 1)",
        "name": "Retrain events",
        "showIn": 0,
        "textFormat": "Retrain event"
      }
    ]
  },
  "panels": [
    {
      "type": "gauge",
      "title": "Current model accuracy",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "model_accuracy"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.75 },
              { "color": "green", "value": 0.85 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "Current drift score",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "model_drift_score"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Accuracy over time",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "model_accuracy",
          "legendFormat": "{{model_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 3, "min": 0, "max": 1 },
        "overrides": []
      },
      "thresholds": [
        {
          "colorMode": "critical",
          "op": "gt",
          "value": 0.75
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drift score over time",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "model_drift_score",
          "legendFormat": "{{model_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 3, "min": 0, "max": 1 },
        "overrides": []
      },
      "thresholds": [
        {
          "colorMode": "critical",
          "op": "gt",
          "value": 0.15
        }
      ]
    }
  ]
}
