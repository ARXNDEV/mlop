{
  "uid": "mlops-abtest",
  "title": "A/B Test",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Total requests v1",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(prediction_requests_total{model_version=\"v1\"})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Total requests v2",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(prediction_requests_total{model_version=\"v2\"})"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Accuracy v1 vs v2",
      "gridPos": { "x": 0, "y": 6, "w": 10, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "model_accuracy",
          "legendFormat": "{{model_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 3, "min": 0, "max": 1 },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "gridPos": { "x": 10, "y": 6, "w": 14, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prediction_requests_total[5m])) by (model_version)",
          "legendFormat": "{{model_version}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2 },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Current AB split (%)",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "ab_split_percent"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 0 },
        "overrides": []
      }
    }
  ]
}
